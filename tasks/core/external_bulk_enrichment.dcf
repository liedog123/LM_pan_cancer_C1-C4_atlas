Task: external_bulk_enrichment
Layer: core
Output-Root: SET_ME_NEW_OUTPUT_ROOT
Input-expression_dir: ../inputs/SET_ME_GEO_expression_files
Input-lm12_manifest: ../inputs/SET_ME_lm_imm_12_manifest.tsv
Input-lm12_genes: ../inputs/SET_ME_lm_imm_12_gene_sets_long.tsv

Step: s01
Script: external_bulk/01_build_external_scores.R
expression_dir: @input/expression_dir
metadata_dir: ../inputs/SET_ME_external_metadata
final_genes: ../inputs/SET_ME_final_selected_genes.rdata
lm12_manifest: @input/lm12_manifest
lm12_genes: @input/lm12_genes
output_dir: @root/external_bulk_enrichment/s01

Step: s02
Script: external_bulk/02_run_lm12_gene_level_gsea.R
expression_dir: @input/expression_dir
lm12_manifest: @input/lm12_manifest
lm12_genes: @input/lm12_genes
output_dir: @root/external_bulk_enrichment/s02
score_dir: @s01/
