# Purpose: genomics input/output paths; parameters remain in the analysis code.
# Copy outside the checkout, replace SET_ME, and select only the required stage(s).
# Use --plan first. No study inputs are distributed in this repository.

Module: genomics
Output-Root: SET_ME_NEW_OUTPUT_ROOT
Input-cnv_burden.continuous_cnv: SET_ME/continuous_cnv.tsv.gz

Stage: somatic_mutations.s01
callable_dir: SET_ME/accepted_callable
mutation_events: SET_ME/mutation.gz
output_dir: @root/somatic_mutations/s01

Stage: tmb_msi.s02
readiness_dir: SET_ME/prepared_readiness
output_dir: @root/tmb_msi/s02

Stage: cnv_burden.s03
readiness_dir: SET_ME/prepared_cnv_readiness
continuous_cnv: @input/cnv_burden.continuous_cnv
thresholded_cnv: SET_ME/thresholded_cnv.tsv.gz
output_dir: @root/cnv_burden/s03

Stage: cnv_burden.s04
continuous_cnv: @input/cnv_burden.continuous_cnv
output_dir: @root/cnv_burden/s04
canonical_labels: SET_ME/canonical_labels.csv
cancer_order: SET_ME/cancer_order.csv
state_palette: SET_ME/state_palette.tsv

Stage: cnv_regions.s05
manifest: SET_ME/cnv_c1c4_sample_manifest.tsv
thresholded_cnv: SET_ME/TCGA_PANCAN_CopyNumber_Gistic2_all_thresholded.gz
gene_coordinates: SET_ME/probeMap_gencode.v23.annotation.gene.probemap
cytoband: SET_ME/cytoBand.txt.gz
output_dir: @root/cnv_regions/s05
