# Purpose: clinical input/output paths; parameters remain in the analysis code.
# Copy outside the checkout, replace SET_ME, and select only the required stage(s).
# Use --plan first. No study inputs are distributed in this repository.

Module: clinical
Output-Root: SET_ME_NEW_OUTPUT_ROOT
Input-ag_survival.projects_data: SET_ME/projects.rdata

Stage: ag_survival.s00
projects_data: @input/ag_survival.projects_data
clinical_groups: SET_ME/clinical_data_cluster_list.rdata
output_dir: @root/ag_survival/s00

Stage: ag_survival.s01
projects_data: @input/ag_survival.projects_data
output_dir: @root/ag_survival/s01
survival_data: @ag_survival.s00/tow_group_clinical_data_list.rdata

Stage: ag_survival.s02
output_dir: @root/ag_survival/s02
cox_results: @ag_survival.s01/Cox_analysis_results.RData
cancer_order: SET_ME/frozen_pan_cancer_order_by_integrated_ssgsea.csv

Stage: ag_survival.s03
output_dir: @root/ag_survival/s03
survival_data: @ag_survival.s00/tow_group_clinical_data_list.rdata

Stage: c1c4_clinical.s01
patient_manifest: ../SET_ME_inputs/clinical_patient_analysis_manifest.tsv
canonical_labels: ../SET_ME_inputs/final_ag3ig2_c1c4_subtype_labels.csv
clinical_data: ../SET_ME_inputs/pancancer_full_data_list.rdata
output_dir: @root/c1c4_clinical/s01

Stage: immune_ecology.s01
canonical_labels: SET_ME_canonical_labels
patient_manifest: SET_ME_patient_manifest
estimate_scores: SET_ME_estimate_scores
cibersort_scores: SET_ME_cibersort_scores
mcpcounter_scores: SET_ME_mcpcounter_scores
acid_genes: SET_ME_acid_genes
lm12_genes: SET_ME_lm12_genes
output_dir: @root/immune_ecology/s01

Stage: immune_ecology.s02
output_dir: @root/immune_ecology/s02
input_results: @immune_ecology.s01/
