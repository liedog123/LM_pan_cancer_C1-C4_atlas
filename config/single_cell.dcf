frozen_cell_metadata: SET_ME_frozen_cell_metadata
sample_labels: SET_ME_sample_labels
readiness: SET_ME_readiness
catalog: SET_ME_SUPPLEMENTARY_DIR/program_catalog_frozen_v0.1.tsv
