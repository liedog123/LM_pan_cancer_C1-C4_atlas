# Purpose: single_cell input/output paths; parameters remain in the analysis code.
# Copy outside the checkout, replace SET_ME, and select only the required stage(s).
# Use --plan first. No study inputs are distributed in this repository.

Module: single_cell
Output-Root: SET_ME_NEW_OUTPUT_ROOT
Input-single_cell_pseudobulk.exclusion_genes: SET_ME_SUPPLEMENTARY_DIR/definition_exclusion_genes.tsv
Input-bassez_sensitivity.sample_sheet: SET_ME_sample_sheet
Input-bassez_sensitivity.counts_manifest: SET_ME_counts_manifest
Input-bassez_sensitivity.model_contract: SET_ME_model_contract
Input-bassez_sensitivity.counts_dir: SET_ME_counts_dir

Stage: single_cell_states.s04
seurat_object: SET_ME/seurat_object
cell_metadata: SET_ME/cell_metadata
sample_metadata: SET_ME/sample_metadata
celltype_to_broad: SET_ME/celltype_to_broad
compartment_manifest: SET_ME/compartment_manifest
sample_inclusion_rule: SET_ME/sample_inclusion_rule
treatment_map: SET_ME/treatment_map
lm12_manifest: SET_ME/lm12_manifest
lm12_gene_long: SET_ME/lm12_gene_long
output_dir: @root/single_cell_states/s04

Stage: single_cell_states.s05
seurat_object: SET_ME/seurat_object
output_dir: @root/single_cell_states/s05
initial_bundle: @single_cell_states.s04/initial_scoring_bundle.rds

Stage: single_cell_states.s01
output_dir: @root/single_cell_states/s01
refine_bundle: @single_cell_states.s05/studywise_refine_bundle.rds

Stage: single_cell_states.s02
seurat_object: SET_ME_seurat_object
output_dir: @root/single_cell_states/s02
refine_bundle: @single_cell_states.s05/studywise_refine_bundle.rds
selected_genes: SET_ME_selected_genes

Stage: single_cell_states.s03
cell_metadata: SET_ME_cell_metadata
sample_metadata: SET_ME_sample_metadata
output_dir: @root/single_cell_states/s03
ig_cell_states: @single_cell_states.s01/cell_level_local_ig_states.tsv.gz
ag_cell_states: @single_cell_states.s02/cell_level_acid_scores_and_ag_states.tsv.gz

Stage: single_cell_pseudobulk.s06
seurat_object: SET_ME_seurat_object
cell_metadata: SET_ME_cell_metadata
sample_mapping: SET_ME_sample_mapping
exclusion_genes: @input/single_cell_pseudobulk.exclusion_genes
g1_summary: SET_ME_g1_summary
output_dir: @root/single_cell_pseudobulk/s06

Stage: single_cell_pseudobulk.s07
output_dir: @root/single_cell_pseudobulk/s07
sample_sheet: @single_cell_pseudobulk.s06/pseudobulk_sample_sheet.tsv.gz
counts_manifest: @single_cell_pseudobulk.s06/pseudobulk_counts_manifest.tsv
counts_gate: @single_cell_pseudobulk.s06/g2a_counts_gate_summary.tsv
counts_dir: @single_cell_pseudobulk.s06/counts

Stage: single_cell_pseudobulk.s08
exclusion_genes: @input/single_cell_pseudobulk.exclusion_genes
output_dir: @root/single_cell_pseudobulk/s08
counts_manifest: @single_cell_pseudobulk.s06/pseudobulk_counts_manifest.tsv
counts_dir: @single_cell_pseudobulk.s06/counts
technical_gate: @single_cell_pseudobulk.s07/g2a_technical_gate_summary.tsv
model_contract: @single_cell_pseudobulk.s07/model_design_contract.tsv
sample_sets_dir: @single_cell_pseudobulk.s07/sample_sets

Stage: single_cell_pseudobulk.s09
output_dir: @root/single_cell_pseudobulk/s09
counts_manifest: @single_cell_pseudobulk.s06/pseudobulk_counts_manifest.tsv
counts_dir: @single_cell_pseudobulk.s06/counts
model_contract: @single_cell_pseudobulk.s07/model_design_contract.tsv
sample_sets_dir: @single_cell_pseudobulk.s07/sample_sets
primary_gate: @single_cell_pseudobulk.s08/g2b_overall_model_gate.tsv
primary_gene_results_dir: @single_cell_pseudobulk.s08/gene_results

Stage: single_cell_pseudobulk.s10
output_dir: @root/single_cell_pseudobulk/s10
primary_gate: @single_cell_pseudobulk.s08/g2b_overall_model_gate.tsv
primary_gene_results_dir: @single_cell_pseudobulk.s08/gene_results
stability_gate: @single_cell_pseudobulk.s09/g2c_stability_gate.tsv
candidates: @single_cell_pseudobulk.s09/stability_candidate_genes.tsv.gz
sensitivity: @single_cell_pseudobulk.s09/sensitivity_gene_concordance.tsv.gz
cohort_meta: @single_cell_pseudobulk.s09/cohort_meta_summary.tsv.gz
loso: @single_cell_pseudobulk.s09/loso_gene_summary.tsv.gz
target_stability_summary: @single_cell_pseudobulk.s09/target_stability_summary.tsv
