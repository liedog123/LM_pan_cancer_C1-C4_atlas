Stage: single_cell_pseudobulk.s11
output_dir: @root/single_cell_pseudobulk/s11
primary_gene_results_dir: @single_cell_pseudobulk.s08/gene_results
evidence_gate: @single_cell_pseudobulk.s10/g2d_evidence_gate.tsv
integrated_gene_evidence: @single_cell_pseudobulk.s10/integrated_gene_evidence.tsv.gz
target_gene_evidence_summary: @single_cell_pseudobulk.s10/target_gene_evidence_summary.tsv
hallmark_gmt: ../SET_ME/h.all.v2025.1.Hs.symbols.gmt
reactome_gmt: ../SET_ME/c2.cp.reactome.v2025.1.Hs.symbols.gmt
gobp_gmt: ../SET_ME/c5.go.bp.v2024.1.Hs.symbols.gmt
c7_gmt: ../SET_ME/c7.all.v2025.1.Hs.symbols.gmt
legacy_c7: ../SET_ME/c7_preranked_gsea_all_results.tsv

Stage: bassez_sensitivity.s12
cell_metadata: SET_ME_cell_metadata
sample_metadata: SET_ME_sample_metadata
sample_labels: SET_ME_sample_labels
sample_compartment_counts: SET_ME_sample_compartment_counts
sample_sheet: @input/bassez_sensitivity.sample_sheet
counts_manifest: @input/bassez_sensitivity.counts_manifest
model_contract: @input/bassez_sensitivity.model_contract
definition_genes: SET_ME_SUPPLEMENTARY_DIR/definition_exclusion_genes.tsv
program_scores: SET_ME_program_scores
program_catalog: SET_ME_SUPPLEMENTARY_DIR/program_catalog_frozen_v0.1.tsv
formal_centers: SET_ME_formal_centers
formal_pathway_evidence: SET_ME_formal_pathway_evidence
fig6_pathway_source: SET_ME_SUPPLEMENTARY_DIR/fig6_d_pathway_selection.tsv
gmt_hallmark: SET_ME_gmt_hallmark
gmt_reactome: SET_ME_gmt_reactome
gmt_gobp: SET_ME_gmt_gobp
